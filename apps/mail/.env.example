# App + backend URLs
VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

# --- Browser-first / local mode (client-side OAuth) ---
# Vite exposes only VITE_* vars to the client. These drive in-browser sign-in;
# no client secret is used in the browser.
#
# Google: OAuth "Web application" client. Add your dev origin (e.g.
# http://localhost:3000) under "Authorized JavaScript origins". GIS issues ~1h
# access tokens in-browser (no refresh token).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Microsoft: Azure app registration, platform = Single-page application (SPA),
# redirect URI = your dev origin. Paste the Application (client) ID.
VITE_MS_CLIENT_ID=your-azure-spa-application-client-id

# --- Optional client vars (app still boots if blank) ---
# Image proxy for remote email images (privacy / referrer stripping)
VITE_PUBLIC_IMAGE_PROXY=
VITE_PUBLIC_IMAGE_API_URL=
# Analytics
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
# Voice assistant (ElevenLabs)
VITE_PUBLIC_ELEVENLABS_AGENT_ID=
VITE_PUBLIC_SERVER_URL=
VITE_PUBLIC_VOICE_SECRET=

# --- Server-mode only (unused in browser-first) ---
# better-auth: generate a random 32-byte hex secret for the server
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
COOKIE_DOMAIN="localhost"

# Google OAuth server credentials (server-mode sign-in / offline access)
# Redirect URI: http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local Redis (valkey + upstash-proxy, docker-compose.db.yaml)
REDIS_URL="http://localhost:8079"
REDIS_TOKEN="upstash-local-token"

# Optional server integrations — leave blank to boot without them
RESEND_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_MODEL=
OPENAI_MINI_MODEL=
AI_SYSTEM_PROMPT=""
AUTUMN_SECRET_KEY=

NODE_ENV="development"
